{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "//": "Local SQL Server Express using Windows authentication, so no password is stored in the project.",
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=EcommerceApiDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "//": "Development-only signing key. Generate a real one and set Jwt__Key outside source control before deploying.",
    "Issuer": "Ecommerce.Api",
    "Audience": "Ecommerce.Api.Clients",
    "Key": "DEVELOPMENT-ONLY-SIGNING-KEY-change-me-0123456789abcdefghijklmnopqrstuvwxyz",
    "ExpiryMinutes": 60
  },
  "PasswordReset": {
    "ExpiryMinutes": 15,
    "ResetUrlBase": "http://localhost:5173"
  },
  "Cors": {
    "PolicyName": "DefaultCorsPolicy",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:7001"
    ]
  }
}
